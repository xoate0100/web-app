{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python .cursor/hooks/session_start.py",
        "timeout": 120
      }
    ],
    "stop": [
      {
        "command": "python .cursor/hooks/stop_review.py",
        "timeout": 120,
        "loop_limit": 2
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python .cursor/hooks/before_commit.py",
        "matcher": "git\\s+commit",
        "failClosed": false,
        "timeout": 180
      }
    ]
  }
}
