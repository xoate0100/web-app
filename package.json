{
  "name": "mifosx-web-app",
  "version": "0.0.0",
  "description": "MifosX Web App is the default web application built on top of the Fineract platform for the Mifos user community leveraging the popular Angular framework.",
  "keywords": [
    "mifos",
    "openmf",
    "fineract",
    "angular"
  ],
  "homepage": "https://github.com/openMF/web-app",
  "license": "MPL-2.0",
  "scripts": {
    "ng": "ng",
    "build": "npm run env -s && ng build --configuration=production --output-hashing=none",
    "build:prod": "node --max-old-space-size=16384 ./node_modules/@angular/cli/bin/ng build --configuration=production --output-hashing=none --base-href=/web-app/",
    "start": "npm run env -s && ng serve --proxy-config proxy.conf.js",
    "serve:sw": "npm run build -s && npx http-server ./dist/web-app/browser -p 4200",
    "lint": "ng lint",
    "lint:all": "ng lint && npm run lint:styles && npm run lint:html",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:html": "htmlhint \"src\" --config .htmlhintrc",
    "test": "npm run env -s && ng test",
    "test:ci": "npm run env -s && npm run lint -s && ng test --code-coverage --watch=false",
    "translations:extract": "ngx-translate-extract --input ./src --output ./src/translations/template.json --format=json --clean -sort --marker extract",
    "docs": "hads ./docs -o",
    "env": "ngx-scripts env npm_package_version"
  },
  "dependencies": {
    "@angular/animations": "^22.0.3",
    "@angular/cdk": "^22.0.3",
    "@angular/common": "^22.0.3",
    "@angular/compiler": "^22.0.3",
    "@angular/core": "^22.0.3",
    "@angular/forms": "^22.0.3",
    "@angular/localize": "^22.0.3",
    "@angular/material": "^22.0.3",
    "@angular/platform-browser": "^22.0.3",
    "@angular/platform-browser-dynamic": "^22.0.3",
    "@angular/router": "^22.0.3",
    "@angular/service-worker": "^22.0.3",
    "@ckeditor/ckeditor5-angular": "^11.2.0",
    "@ckeditor/ckeditor5-build-classic": "^44.3.0",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@ngbracket/ngx-layout": "^22.0.0",
    "@ngx-translate/core": "^16.0.4",
    "chart.js": "^4.5.1",
    "lodash": "^4.17.21",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.3",
    "@angular/language-service": "^22.0.3",
    "@biesbjerg/ngx-translate-extract": "^7.0.4",
    "@eslint/js": "^10.0.1",
    "@ngx-rocket/scripts": "^5.2.3",
    "@types/jasmine": "^5.1.8",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.15.3",
    "angular-eslint": "22.0.0",
    "eslint": "^10.3.0",
    "globals": "^17.7.0",
    "hads": "^3.0.3",
    "htmlhint": "^1.1.4",
    "jasmine-core": "^5.7.1",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "karma-junit-reporter": "^2.0.1",
    "stylelint": "^16.19.1",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-scss": "^6.12.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.60.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openMF/web-app.git"
  },
  "bugs": {
    "url": "https://github.com/openMF/web-app/issues"
  },
  "engines": {
    "node": ">= 20.19.0",
    "npm": ">= 10.0.0"
  }
}
