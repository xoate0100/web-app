{
  "name": "mifosx-web-app",
  "version": "0.0.0",
  "description": "MifosX Web App is the default web application built on top of the Fineract platform for the Mifos user community leveraging the popular Angular framework.",
  "keywords": [
    "mifos",
    "openmf",
    "fineract",
    "angular"
  ],
  "homepage": "https://github.com/openMF/web-app",
  "license": "MPL-2.0",
  "scripts": {
    "ng": "ng",
    "build": "npm run env -s && ng build --configuration=production --output-hashing=none",
    "build:prod": "node --max-old-space-size=16384 ./node_modules/@angular/cli/bin/ng build --configuration=production --output-hashing=none --base-href=/web-app/",
    "start": "npm run env -s && ng serve --proxy-config proxy.conf.js",
    "serve:sw": "npm run build -s && npx http-server ./dist/web-app/browser -p 4200",
    "lint": "ng lint",
    "lint:all": "ng lint && npm run lint:styles && npm run lint:html",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:html": "htmlhint \"src\" --config .htmlhintrc",
    "test": "npm run env -s && ng test",
    "test:ci": "npm run env -s && ng test --watch=false",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --reporter=list",
    "e2e:install": "playwright install chromium --with-deps",
    "validate": "npm run lint:all && npm run test:ci && npm run build:prod",
    "validate:all": "npm run validate && npm run e2e:ci",
    "translations:extract": "ngx-translate-extract --input ./src --output ./src/translations/template.json --format=json --clean -sort --marker extract",
    "docs": "hads ./docs -o",
    "env": "ngx-scripts env npm_package_version"
  },
  "dependencies": {
    "@angular/animations": "^22.0.6",
    "@angular/cdk": "^22.0.4",
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/localize": "^22.0.6",
    "@angular/material": "^22.0.4",
    "@angular/platform-browser": "^22.0.6",
    "@angular/router": "^22.0.6",
    "@angular/service-worker": "^22.0.6",
    "@ckeditor/ckeditor5-angular": "^11.2.0",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@ngbracket/ngx-layout": "^22.0.0",
    "@ngx-translate/core": "^18.0.0",
    "chart.js": "^4.5.1",
    "ckeditor5": "^47.7.2",
    "lodash": "^4.17.21",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.6",
    "@angular/language-service": "^22.0.6",
    "@biesbjerg/ngx-translate-extract": "^7.0.4",
    "@eslint/js": "^10.0.1",
    "@ngx-rocket/scripts": "^5.2.3",
    "@playwright/test": "^1.61.1",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "22.0.0",
    "eslint": "^10.3.0",
    "globals": "^17.7.0",
    "hads": "^3.0.3",
    "htmlhint": "^1.1.4",
    "https-proxy-agent": "^9.1.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.19",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-scss": "^6.14.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openMF/web-app.git"
  },
  "bugs": {
    "url": "https://github.com/openMF/web-app/issues"
  },
  "engines": {
    "node": ">= 20.19.0",
    "npm": ">= 10.0.0"
  }
}
