{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/spec",
    "baseUrl": "./",
    "types": [
      "node"
    ],
    "typeRoots": [
      "../node_modules/@types"
    ]
  },
  "include": [
    "**/*.spec.ts",
    "**/*.mock.ts",
    "**/*.module.ts",
    "**/*.d.ts",
    "polyfills-test.ts",
    "test-globals.ts",
    "vitest-globals.d.ts"
  ],
  "angularCompilerOptions": {
    "preserveWhitespaces": true,
    "strictTemplates": false
  }
}
